{
  "type": "object",
  "required": ["claims"],
  "additionalProperties": false,
  "properties": {
    "claims": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "required": ["packetId", "text", "status"], "additionalProperties": false,
        "properties": {
          "packetId": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1, "maxLength": 600 },
          "status": { "enum": ["current", "stale", "contradicted", "unverified"] },
          "reference": { "type": "string", "maxLength": 300 }
        }
      }
    }
  }
}
