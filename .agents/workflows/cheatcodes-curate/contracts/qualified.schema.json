{
  "type": "object",
  "required": [
    "verdicts"
  ],
  "additionalProperties": false,
  "properties": {
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "packetId",
          "verdict",
          "claims",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "packetId": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "accept",
              "reject",
              "needs-review"
            ]
          },
          "claims": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "text",
                "evidence"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "rejectionReasons": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "maxLength": 120
            }
          },
          "notes": {
            "type": "string",
            "maxLength": 600,
            "minLength": 1
          }
        }
      }
    }
  }
}