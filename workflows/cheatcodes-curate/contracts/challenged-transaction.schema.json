{
  "type": "object",
  "required": ["decision", "rationale"],
  "additionalProperties": false,
  "properties": {
    "decision": { "enum": ["approved", "revised", "rejected"] },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "transaction": {
      "type": "object", "required": ["baseRevision", "operations"], "additionalProperties": false,
      "properties": {
        "baseRevision": { "type": "string", "minLength": 1 },
        "packetIds": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "operations": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object", "required": ["op"], "additionalProperties": true,
            "properties": { "op": { "enum": ["create", "update", "merge", "delete", "keep", "needs-review"] } }
          }
        }
      }
    }
  }
}
